# Copie para .env. Nunca faça commit do arquivo preenchido.
# Autenticação Supabase: URL HTTPS do projeto e chave pública; lidas somente no servidor.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# D1 local: nome e UUID do banco local. Não altere ao usar uma base existente.
# O banco financeiro usa binding D1, não conexão PostgreSQL com host/porta/senha.
LOCAL_D1_DATABASE_NAME=
LOCAL_D1_DATABASE_ID=
# E-mail opcional: configure gateway HTTPS idempotente antes de ativar.
NOTIFICATION_CRON_SECRET=
NOTIFICATION_GATEWAY_TOKEN=
EMAIL_GATEWAY_URL=
# Origem HTTPS acessível pelo worker de agendamento.
SITE_ORIGIN=
# Somente servidor Node/Render: PostgreSQL com SSL verificado.
DATABASE_URL=
# Caminho do certificado CA (Render: arquivo secreto em /etc/secrets/).
PGSSLROOTCERT=
APP_ORIGIN=
